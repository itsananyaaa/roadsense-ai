# RoadSense AI — Environment Configuration Template
# Copy this file to .env:
#   cp .env.example .env
#
# IMPORTANT:
# - Never commit the .env file to version control.
# - The backend operates in a fail-closed posture: if credentials are not
#   configured, all authenticated endpoints will reject requests (HTTP 401).

# Municipal Administrator Username
ROADSENSE_ADMIN_USER=admin

# Municipal Administrator Password (must be set by operator)
ROADSENSE_ADMIN_PASS=your_secure_password_here

# HMAC-SHA256 Session Secret Key
# Generate a secure 32-byte (64-character hex) key:
#   openssl rand -hex 32
ROADSENSE_SESSION_SECRET=your_32_byte_hex_session_secret_here
