# RoadSense AI — .gitignore
# Strictly exclude sensitive credentials, local databases, runtime uploads, and large caches

# ==============================================================================
# 1. Credentials, Secrets & Local Environments
# ==============================================================================
.env
.env.*
!.env.example
.secrets.baseline
.streamlit/secrets.toml
*.pem
*.key
*.p12

# ==============================================================================
# 2. Local Databases & Persistence (SQLite runtime state)
# ==============================================================================
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
instance/

# ==============================================================================
# 3. Model Weights & Checkpoints (> 50 MB or temporary smoke/run models)
# ==============================================================================
*.pt
*.pth
*.onnx
*.engine
*.tflite
*.pb
weights/
runs/
models/*.pt
models/checkpoints/

# ==============================================================================
# 4. Runtime Data, Evidence Uploads & Datasets
# ==============================================================================
data/*
!data/demo_media/
!data/demo_media/**
!data/manifests/
data/evidence/
data/field_samples/
data/smoke/
scratch/
datasets/
RDD2022/
*.zip
*.tar.gz
*.bin
*.xml

# Runtime media uploads
*.mp4
*.avi
*.mov
*.mkv
*.jpg
*.jpeg
*.png
*.webp
!reports/*.png
!docs/*.png
!data/demo_media/images/*.jpg
!core/fonts/*.ttf
!core/fonts/*.txt
!web/static/assets/leaflet/*

# ==============================================================================
# 5. Python & Virtual Environments
# ==============================================================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
miniconda/

# ==============================================================================
# 6. Test & Coverage Caches
# ==============================================================================
.pytest_cache/
.coverage
htmlcov/

# ==============================================================================
# 7. IDE & Operating System Metadata
# ==============================================================================
.DS_Store
.AppleDouble
.LSOverride
._*
.vscode/
.idea/
*.swp
*.swo
/tmp/
